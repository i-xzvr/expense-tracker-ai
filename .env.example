# OPTIONAL server settings. Copy to .env.local, fill only what you need,
# then restart V4. Base app, Ollama, PDF, and installed OneDrive need no keys.
# Never commit .env.local or paste usable secrets into chat/issues.

# Existing signed-in OneDrive desktop sync folder override:
# V4_ONEDRIVE_ROOT='C:\Users\YourName\OneDrive'

# Microsoft public-client registration (not a client secret):
# V4_MS_CLIENT_ID='YOUR_PUBLIC_APPLICATION_UUID'
# V4_MS_TENANT='consumers'

# Google OAuth: three refresh fields together OR a short-lived access token:
# V4_GOOGLE_CLIENT_ID='YOUR_OAUTH_CLIENT_ID'
# V4_GOOGLE_CLIENT_SECRET='YOUR_OAUTH_CLIENT_SECRET'
# V4_GOOGLE_REFRESH_TOKEN='YOUR_OAUTH_REFRESH_TOKEN'
# V4_GOOGLE_ACCESS_TOKEN='YOUR_SHORT_LIVED_OAUTH_ACCESS_TOKEN'

# Start-V4.cmd supplies runtime paths and loopback addresses.
# Claude jobs use your Claude Code login, not an API key from this file.
